---
interface Props {
  src: string;
  alt: string;
  aspectRatio?: string;
  useCanvas?: boolean;
}

const { src, alt, aspectRatio = '2 / 1', useCanvas = false } = Astro.props;
---

{useCanvas ? (
  <div class="protected-image" style={`aspect-ratio: ${aspectRatio}`}>
    <canvas
      class="protected-canvas"
      data-src={src}
      aria-label={alt}
      role="img"
    ></canvas>
    <div class="shield" aria-hidden="true"></div>
  </div>
) : (
  <div
    class="protected-image"
    style={`aspect-ratio: ${aspectRatio}; background-image: url('${src}')`}
    role="img"
    aria-label={alt}
  >
    <div class="shield" aria-hidden="true"></div>
  </div>
)}

<style>
  .protected-image {
    position: relative;
    width: 100%;
    overflow: hidden;
    background-color: var(--color-surface);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    -webkit-user-select: none;
    user-select: none;
    -webkit-user-drag: none;
  }

  .protected-canvas {
    width: 100%;
    height: 100%;
    display: block;
  }

  .shield {
    position: absolute;
    inset: 0;
    pointer-events: auto;
    z-index: 10;
  }

  .protected-image * {
    -webkit-user-drag: none;
  }
</style>

<script>
  document.querySelectorAll('.protected-canvas[data-src]').forEach((canvas) => {
    const el = canvas as HTMLCanvasElement;
    const src = el.dataset.src;
    if (!src) return;

    const ctx = el.getContext('2d');
    if (!ctx) return;

    const img = new Image();
    img.crossOrigin = 'anonymous';
    img.onload = () => {
      const parent = el.parentElement;
      if (!parent) return;
      el.width = parent.clientWidth * window.devicePixelRatio;
      el.height = parent.clientHeight * window.devicePixelRatio;
      el.style.width = '100%';
      el.style.height = '100%';
      ctx.drawImage(img, 0, 0, el.width, el.height);
    };
    img.src = src;
  });

  document.addEventListener('contextmenu', (e) => {
    if ((e.target as Element).closest('.protected-image')) {
      e.preventDefault();
    }
  });

  document.addEventListener('dragstart', (e) => {
    if ((e.target as Element).closest('.protected-image')) {
      e.preventDefault();
    }
  });
</script>
