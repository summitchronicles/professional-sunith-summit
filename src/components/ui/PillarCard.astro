---
interface Props {
  href: string;
  title: string;
  subtitle: string;
}

const { href, title, subtitle } = Astro.props;
---

<a href={href} class="pillar-card reveal">
  <h2 class="pillar-title">{title}</h2>
  <p class="pillar-subtitle">{subtitle}</p>
</a>

<style>
  .pillar-card {
    display: block;
    padding: var(--space-xl) var(--space-lg);
    background-color: var(--color-bg);
    transition: background-color var(--transition-slow);
  }

  .pillar-card:hover {
    background-color: var(--color-surface);
    color: var(--color-text-primary);
  }

  .pillar-title {
    margin-bottom: var(--space-xs);
  }

  .pillar-subtitle {
    color: var(--color-text-muted);
    font-size: 1rem;
    line-height: 1.5;
  }

  .pillar-card:hover .pillar-subtitle {
    color: var(--color-text-secondary);
  }
</style>
