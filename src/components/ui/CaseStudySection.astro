---
interface Props {
  label: string;
  content: string;
  accent?: boolean;
}

const { label, content, accent = false } = Astro.props;
---

<div class="case-section reveal protected-content">
  <span class="case-label mono">{label}</span>
  <p class:list={['case-content', { 'case-accent': accent }]}>{content}</p>
</div>

<style>
  .case-section {
    padding: var(--space-xl) 0 0;
  }

  .case-label {
    display: block;
    margin-bottom: var(--space-sm);
  }

  .case-content {
    color: var(--color-text-secondary);
    line-height: 1.8;
  }

  .case-accent {
    color: var(--color-accent);
  }
</style>
