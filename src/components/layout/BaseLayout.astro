---
import SEOHead from '../seo/SEOHead.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import '../../styles/global.css';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: 'website' | 'article';
  showHeader?: boolean;
  showFooter?: boolean;
}

const {
  title,
  description,
  ogImage,
  ogImageAlt,
  ogType,
  showHeader = true,
  showFooter = true,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <SEOHead
      title={title}
      description={description}
      ogImage={ogImage}
      ogImageAlt={ogImageAlt}
      ogType={ogType}
    />
  </head>
  <body>
    {showHeader && <Header />}
    <main class:list={[{ 'has-header': showHeader }]}>
      <slot />
    </main>
    {showFooter && <Footer />}
  </body>
</html>

<style>
  main.has-header {
    padding-top: 4rem; /* Clear fixed header */
  }
</style>
