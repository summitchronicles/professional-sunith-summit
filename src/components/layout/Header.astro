---
const currentPath = Astro.url.pathname;

const links = [
  { href: '/work/', label: 'Work' },
  { href: '/thinking/', label: 'Thinking' },
  { href: '/expeditions/', label: 'Expeditions' },
];
---

<header class="header">
  <nav class="nav">
    <a href="/" class="logo" aria-label="Sunith Kumar Kokku home">
      <img
        src="/images/logo-mark-320.png"
        srcset="/images/logo-mark-320.png 1x, /images/logo-mark-640.png 2x"
        width="320"
        height="324"
        alt="Sunith logo"
        class="logo-image"
        decoding="async"
      />
    </a>
    <ul class="nav-links">
      {links.map(({ href, label }) => (
        <li>
          <a
            href={href}
            class:list={['nav-link', { active: currentPath.startsWith(href) }]}
          >
            {label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    padding: var(--space-md) var(--content-padding);
    background-color: rgba(10, 10, 10, 0.9);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }

  .nav {
    max-width: var(--content-width);
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .logo {
    display: inline-flex;
    align-items: center;
    transition: opacity var(--transition-slow), transform var(--transition-slow);
  }

  .logo:hover {
    opacity: 0.96;
    transform: translateY(-0.5px);
  }

  .logo-image {
    height: clamp(1.45rem, 1vw + 1.2rem, 1.85rem);
    width: auto;
    display: block;
    opacity: 0.92;
    filter: brightness(1.32) contrast(1.08) saturate(0.82);
  }

  .nav-links {
    display: flex;
    gap: var(--space-lg);
  }

  .nav-link {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    transition: color var(--transition-slow);
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--color-text-primary);
  }

  @media (max-width: 640px) {
    .nav-links {
      gap: var(--space-md);
    }

    .nav-link {
      font-size: 0.875rem;
    }
  }
</style>
