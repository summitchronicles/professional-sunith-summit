---
import { getCollection } from 'astro:content';
import BaseLayout from '../components/layout/BaseLayout.astro';
import ScrollReveal from '../components/ui/ScrollReveal.astro';

const thoughts = (await getCollection('thinking', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);
const featured =
  thoughts.find((entry) =>
    entry.id.includes('what-engineering-leadership-must-become')
  ) ?? thoughts[0];
const otherThoughts = thoughts.filter((entry) => entry.id !== featured.id);
const work = (await getCollection('work', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);
const expeditions = await getCollection('expeditions', ({ data }) => !data.draft);
const contactNumber = expeditions.length > 0 ? '06' : '05';

const record = [
  {
    meta: 'Evernorth / 2026 to now',
    title: 'Operating model and AI strategy',
    body: 'Built the enterprise operating model and the AI strategy that served as the base before an AI CoE was set up. I now lead consulting on engineering excellence, AI strategy, and moving capabilities from the US to the GCCs.',
  },
  {
    meta: 'Thomson Reuters / 2023 to 2026',
    title: '1 to 300 engineers',
    body: 'Grew the India hub from 1 to 300 engineers across a $40M portfolio, and on-time delivery moved from 65% to 89%. The hardest call was moving system knowledge from vendor staff into the TR team, and the business ended up more independent.',
  },
  {
    meta: 'Pegasystems / 2022 to 2023',
    title: 'Delivery for Australia and New Zealand',
    body: 'Led delivery with government and defence clients. It was high-pressure work, and the team kept overachieving.',
  },
  {
    meta: 'Accenture / 2020 to 2022',
    title: '$250K to $15M',
    body: 'Took on the regional leader role for the Google portfolio from India. We grew the portfolio from $250K to $15M and the team from 1 to 80+, and I learned budgets, billing, margin and hiring on the job.',
  },
  {
    meta: 'Thomson Reuters / 2012 to 2020',
    title: 'Legal data, testing, delivery',
    body: 'Started as a publishing specialist on legal data used by some of the highest courts in the world. About two years in testing taught me that unclear requirements become bugs. From there I moved into product, project and engineering management.',
  },
];

const contentHref = (section: string, id: string) =>
  `/${section}/${id.replace(/\.(mdx?|md)$/, '')}/`;
const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('en', { month: 'short', year: 'numeric' }).format(date);
---

<BaseLayout
  title="Sunith Kumar Kokku | Engineering leadership, GCCs and AI delivery"
  description="I build systems that survive pressure. Engineering and delivery leadership at Thomson Reuters, Accenture, Pegasystems and Evernorth. Open to engineering leadership roles and consulting."
  showHeader={false}
>
  <header class="masthead">
    <a href="/" class="brand" aria-label="Sunith Kumar Kokku home">
      <img
        src="/images/logo-mark-320.png"
        srcset="/images/logo-mark-320.png 1x, /images/logo-mark-640.png 2x"
        width="320"
        height="324"
        alt=""
      />
      <span>Sunith Kumar Kokku</span>
    </a>
    <nav aria-label="Primary navigation">
      <a href="#work">Work</a>
      <a href="#thinking">Thinking</a>
      <a href="#contact">Contact</a>
    </nav>
  </header>

  <section class="hero">
    <div class="hero-portrait" aria-hidden="true"></div>
    <div class="hero-shade" aria-hidden="true"></div>
    <div class="hero-copy">
      <p class="eyebrow">Engineering and GCC leadership / AI delivery</p>
      <h1>I build systems that<br />survive pressure.</h1>
      <p class="hero-summary">
        I’m Sunith Kumar Kokku. I work across technology, teams, and operating
        models to make complex change dependable.
      </p>
      <div class="hero-actions">
        <a class="hero-link" href="#work">See the track record <span aria-hidden="true">↗</span></a>
        <a class="hero-link hero-link-secondary" href="https://www.linkedin.com/in/sunith-kumar-k/" target="_blank" rel="noopener noreferrer">LinkedIn <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <section class="focus section" id="focus" aria-labelledby="focus-title">
    <div class="section-label reveal">
      <span class="mono">01 / Focus</span>
      <span class="rule"></span>
    </div>
    <div class="focus-intro reveal">
      <h2 id="focus-title">Make complex work hold together.</h2>
      <p>My focus is where engineering decisions meet the realities of people, operations, and change.</p>
    </div>
    <div class="focus-list">
      <div class="focus-row reveal">
        <span class="mono">01</span>
        <h3>Reliable systems</h3>
        <p>Build for the conditions a system will actually face, including scale, uncertainty, and failure.</p>
      </div>
      <div class="focus-row reveal">
        <span class="mono">02</span>
        <h3>Useful AI</h3>
        <p>Turn promising capability into workflows with clear evaluation, ownership, and economics.</p>
      </div>
      <div class="focus-row reveal">
        <span class="mono">03</span>
        <h3>Organizational clarity</h3>
        <p>Give teams the decisions, boundaries, and operating rhythm needed to make progress last.</p>
      </div>
    </div>
  </section>

  <section class="work section" id="work" aria-labelledby="work-title">
    <div class="section-label reveal">
      <span class="mono">02 / Track record</span>
      <span class="rule"></span>
    </div>
    <div class="work-heading reveal">
      <h2 id="work-title">Where I've done the work.</h2>
      <p>Engineering and delivery leadership since 2012, at Thomson Reuters, Accenture, Pegasystems and Evernorth.</p>
    </div>
    <div class="work-list">
      {record.map((item) => (
        <div class="work-item record-item reveal">
          <span class="mono">{item.meta}</span>
          <h3>{item.title}</h3>
          <p>{item.body}</p>
        </div>
      ))}
    </div>
  </section>

  {work.length > 0 && (
    <section class="work section" id="projects" aria-labelledby="projects-title">
      <div class="section-label reveal">
        <span class="mono">03 / Independent work</span>
        <span class="rule"></span>
      </div>
      <div class="work-heading reveal">
        <h2 id="projects-title">Things I build myself.</h2>
        <p>Personal builds where I try data pipelines and AI tooling end to end.</p>
      </div>
      <div class="work-list">
        {work.map((entry) => (
          <a class="work-item reveal" href={contentHref('work', entry.id)}>
            <span class="mono">{entry.data.period} / {entry.data.role}</span>
            <h3>{entry.data.title}</h3>
            <p>{entry.data.summary}</p>
            <span class="read-link">Read the story <span aria-hidden="true">↗</span></span>
          </a>
        ))}
      </div>
    </section>
  )}

  <section class="thinking section" id="thinking">
    <div class="section-label reveal">
      <span class="mono">04 / Thinking</span>
      <span class="rule"></span>
    </div>

    <a class="featured reveal" href={contentHref('thinking', featured.id)}>
      <div class="featured-meta mono">
        <span>{formatDate(featured.data.publishDate)}</span>
        <span>{featured.data.readingTime} min read</span>
      </div>
      <h2>{featured.data.title}</h2>
      <p>{featured.data.summary}</p>
      <span class="read-link">Read essay <span aria-hidden="true">↗</span></span>
    </a>

    {otherThoughts.length > 0 && (
      <div class="essay-list">
        {otherThoughts.map((thought) => (
          <a class="essay-row reveal" href={contentHref('thinking', thought.id)}>
            <span>{thought.data.title}</span>
            <span class="mono">{thought.data.readingTime} min ↗</span>
          </a>
        ))}
      </div>
    )}
  </section>

  {expeditions.length > 0 && (
    <section class="expeditions section" id="expeditions">
      <div class="section-label reveal">
        <span class="mono">05 / Beyond work</span>
        <span class="rule"></span>
      </div>
      {expeditions.map((expedition) => (
        <a
          class:list={['expedition-card', 'reveal', { 'no-image': !expedition.data.heroImage }]}
          href={contentHref('expeditions', expedition.id)}
        >
          {expedition.data.heroImage ? (
            <div class="expedition-image" style={`background-image: url('${expedition.data.heroImage}')`}>
              <div class="expedition-overlay"></div>
            </div>
          ) : (
            <div class="expedition-type" aria-hidden="true">
              <span class="mono">Field note / {formatDate(expedition.data.date)}</span>
              <strong>{expedition.data.elevation}</strong>
            </div>
          )}
          <div class="expedition-copy">
            <span class="mono">{expedition.data.region} · {expedition.data.elevation}</span>
            <h2>{expedition.data.mountain}</h2>
            <p>{expedition.data.summary}</p>
            <span class="read-link">View field note <span aria-hidden="true">↗</span></span>
          </div>
        </a>
      ))}
    </section>
  )}

  <section class="contact section" id="contact" aria-labelledby="contact-title">
    <div class="section-label reveal">
      <span class="mono">{contactNumber} / Contact</span>
      <span class="rule"></span>
    </div>
    <div class="contact-inner reveal">
      <h2 id="contact-title">What are you building?</h2>
      <p>I’m open to engineering leadership roles and consulting work on delivery reliability, AI adoption, and GCC operating models.</p>
      <div class="contact-links">
        <a href="mailto:sunith07@gmail.com?subject=Let's%20talk%20about%20working%20together">Start a conversation <span aria-hidden="true">↗</span></a>
        <a href="https://www.linkedin.com/in/sunith-kumar-k/" target="_blank" rel="noopener noreferrer">View LinkedIn <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <ScrollReveal />
</BaseLayout>

<style>
  .masthead {
    position: absolute;
    inset: 0 0 auto;
    z-index: 10;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-lg) var(--content-padding);
    max-width: calc(var(--content-width) + (2 * var(--content-padding)));
    margin: 0 auto;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 1rem;
    letter-spacing: 0.01em;
  }

  .brand img {
    width: 1.8rem;
    height: auto;
    filter: brightness(0) invert(1);
  }

  .masthead nav {
    display: flex;
    gap: var(--space-lg);
    font-size: 0.95rem;
    color: var(--color-text-secondary);
  }

  .masthead a {
    transition: color var(--transition-slow), opacity var(--transition-slow);
  }

  .masthead a:hover {
    color: var(--color-text-primary);
  }

  .hero {
    position: relative;
    min-height: 100dvh;
    display: flex;
    align-items: flex-end;
    background: var(--color-bg);
    isolation: isolate;
  }

  .hero-portrait {
    position: absolute;
    inset: 0 0 0 auto;
    z-index: -2;
    width: 62%;
    background: url('/images/portrait_landscape.jpg') center / cover no-repeat;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 22%);
    mask-image: linear-gradient(90deg, transparent, #000 22%);
  }

  .hero-shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(180deg, rgba(10, 10, 10, 0.82) 0%, transparent 32%),
      linear-gradient(90deg, rgba(10, 10, 10, 0.86) 0%, rgba(10, 10, 10, 0.75) 55%, rgba(10, 10, 10, 0.08) 72%, rgba(10, 10, 10, 0.38) 100%),
      linear-gradient(0deg, var(--color-bg) 0%, transparent 48%);
  }

  .hero-copy {
    width: 100%;
    max-width: var(--content-width);
    margin: 0 auto;
    padding: 0 var(--content-padding) clamp(5rem, 12vh, 8rem);
  }

  .eyebrow {
    margin-bottom: var(--space-md);
    color: var(--color-text-secondary);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0;
    animation: enter 900ms 100ms forwards;
  }

  .hero h1 {
    max-width: 13ch;
    font-size: clamp(3.25rem, 8vw, 7.5rem);
    line-height: 0.93;
    letter-spacing: -0.055em;
    text-shadow: 0 2px 28px rgba(0, 0, 0, 0.55);
    opacity: 0;
    animation: enter 1100ms 200ms forwards;
  }

  .hero-summary {
    max-width: 37ch;
    margin-top: var(--space-lg);
    color: var(--color-text-secondary);
    font-size: clamp(1.05rem, 2vw, 1.35rem);
    opacity: 0;
    animation: enter 1000ms 400ms forwards;
  }

  .hero-link,
  .read-link {
    display: inline-flex;
    gap: 0.5rem;
    align-items: center;
    margin-top: var(--space-lg);
    color: var(--color-text-primary);
    font-size: 1rem;
  }

  .hero-link {
    opacity: 0;
    animation: enter 1000ms 550ms forwards;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0 var(--space-lg);
  }

  .hero-link-secondary {
    color: var(--color-text-secondary);
  }

  @keyframes enter {
    from { opacity: 0; transform: translateY(1.25rem); }
    to { opacity: 1; transform: translateY(0); }
  }

  .section {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: var(--space-3xl) var(--content-padding) 0;
    scroll-margin-top: var(--space-lg);
  }

  .section-label {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    margin-bottom: var(--space-xl);
  }

  .rule {
    height: 1px;
    flex: 1;
    background: var(--color-border);
  }

  .focus-intro,
  .work-heading {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    align-items: end;
    gap: var(--space-xl);
    margin-bottom: var(--space-xl);
  }

  .focus-intro h2,
  .work-heading h2 {
    max-width: 14ch;
    font-size: clamp(2.5rem, 5vw, 4.5rem);
  }

  .focus-intro p,
  .work-heading p {
    max-width: 34ch;
    color: var(--color-text-secondary);
  }

  .focus-list {
    border-top: 1px solid var(--color-border);
  }

  .focus-row {
    display: grid;
    grid-template-columns: 3rem minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: var(--space-lg);
    align-items: baseline;
    padding: var(--space-lg) 0;
    border-bottom: 1px solid var(--color-border);
  }

  .focus-row h3 {
    font-size: clamp(1.5rem, 2.5vw, 2.2rem);
    font-weight: 400;
    line-height: 1.2;
  }

  .focus-row p {
    max-width: 34ch;
    color: var(--color-text-secondary);
    font-size: 1.05rem;
  }

  .work-list {
    border-top: 1px solid var(--color-border);
  }

  .work-item {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: var(--space-md) var(--space-xl);
    padding: var(--space-lg) 0;
    border-bottom: 1px solid var(--color-border);
  }

  .work-item > .mono {
    grid-row: span 3;
  }

  .work-item h3 {
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 400;
    line-height: 1.1;
    transition: color var(--transition-slow);
  }

  .work-item p {
    max-width: 42ch;
    color: var(--color-text-secondary);
  }

  .work-item .read-link {
    margin-top: var(--space-sm);
  }

  .record-item h3 {
    font-size: clamp(1.6rem, 3vw, 2.6rem);
  }

  a.work-item:hover h3 {
    color: var(--color-accent);
  }

  .featured {
    display: block;
    max-width: 54rem;
  }

  .featured-meta {
    display: flex;
    gap: var(--space-lg);
    margin-bottom: var(--space-md);
  }

  .featured h2 {
    font-size: clamp(2.5rem, 6vw, 5.8rem);
    line-height: 0.98;
    letter-spacing: -0.045em;
    transition: color var(--transition-slow);
  }

  .featured > p {
    max-width: 48ch;
    margin-top: var(--space-lg);
    color: var(--color-text-secondary);
  }

  .featured:hover h2,
  .essay-row:hover,
  .expedition-card:hover h2 {
    color: var(--color-accent);
  }

  .essay-list {
    margin-top: var(--space-2xl);
    border-top: 1px solid var(--color-border);
  }

  .essay-row {
    display: flex;
    justify-content: space-between;
    gap: var(--space-lg);
    padding: var(--space-lg) 0;
    border-bottom: 1px solid var(--color-border);
    transition: color var(--transition-slow);
  }

  .expedition-card {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(18rem, 0.8fr);
    min-height: 29rem;
    background: var(--color-surface);
  }

  .expedition-image {
    position: relative;
    min-height: 24rem;
    background-position: center;
    background-size: cover;
    filter: grayscale(1) contrast(1.08);
    overflow: hidden;
  }

  .expedition-type {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 24rem;
    padding: var(--space-xl);
    background: radial-gradient(circle at 70% 65%, #252525, #111 62%);
  }

  .expedition-type strong {
    font-family: var(--font-family);
    font-size: clamp(4.5rem, 10vw, 8rem);
    font-weight: 400;
    letter-spacing: -0.07em;
    line-height: 1;
  }

  .expedition-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, transparent 60%, var(--color-surface));
  }

  .expedition-copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: var(--space-xl);
  }

  .expedition-copy h2 {
    margin: var(--space-md) 0;
    transition: color var(--transition-slow);
  }

  .expedition-copy p {
    color: var(--color-text-secondary);
    font-size: 1.05rem;
  }

  .contact {
    padding-bottom: var(--space-2xl);
  }

  .contact-inner h2 {
    max-width: 15ch;
    font-size: clamp(3rem, 6vw, 5.5rem);
  }

  .contact-inner p {
    max-width: 37ch;
    margin-top: var(--space-lg);
    color: var(--color-text-secondary);
  }

  .contact-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md) var(--space-lg);
    margin-top: var(--space-lg);
  }

  .contact-links a {
    border-bottom: 1px solid var(--color-accent);
    padding-bottom: 0.2rem;
    transition: color var(--transition-slow);
  }

  .contact-links a:hover {
    color: var(--color-accent);
  }

  @media (max-width: 760px) {
    .masthead {
      width: 100vw;
      max-width: none;
      padding-top: var(--space-md);
      padding-bottom: var(--space-lg);
      background: linear-gradient(180deg, rgba(10, 10, 10, 0.88), rgba(10, 10, 10, 0.55) 55%, transparent);
    }

    .brand span {
      display: none;
    }

    .masthead nav {
      gap: var(--space-md);
      font-size: 0.88rem;
    }

    .hero {
      min-height: 100dvh;
    }

    .hero-portrait {
      bottom: auto;
      width: 100%;
      height: 52dvh;
      background-position: 42% center;
      -webkit-mask-image: linear-gradient(180deg, #000 0%, #000 58%, transparent 100%);
      mask-image: linear-gradient(180deg, #000 0%, #000 58%, transparent 100%);
    }

    .hero-shade {
      background:
        linear-gradient(180deg, rgba(10, 10, 10, 0.7) 0%, transparent 24%),
        linear-gradient(0deg, var(--color-bg) 0%, transparent 54%);
    }

    .hero h1 {
      max-width: 10ch;
      font-size: clamp(2.75rem, 12vw, 4.25rem);
    }

    .hero h1 br {
      display: none;
    }

    .section {
      padding-top: var(--space-2xl);
    }

    .focus-intro,
    .work-heading {
      grid-template-columns: 1fr;
      gap: var(--space-md);
    }

    .focus-row {
      grid-template-columns: 2rem 1fr;
      gap: var(--space-sm) var(--space-md);
    }

    .focus-row p {
      grid-column: 2;
    }

    .work-item {
      grid-template-columns: 1fr;
    }

    .work-item > .mono {
      grid-row: auto;
    }

    .featured h2 {
      font-size: clamp(2.35rem, 12vw, 4rem);
    }

    .essay-row {
      align-items: flex-start;
      flex-direction: column;
      gap: var(--space-sm);
    }

    .expedition-card {
      grid-template-columns: 1fr;
    }

    .expedition-image {
      min-height: 18rem;
    }

    .expedition-type {
      min-height: 16rem;
      padding: var(--space-lg);
    }

    .expedition-overlay {
      background: linear-gradient(0deg, var(--color-surface), transparent 55%);
    }

    .expedition-copy {
      padding: var(--space-lg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .eyebrow,
    .hero h1,
    .hero-summary,
    .hero-link {
      opacity: 1;
      animation: none;
    }
  }
</style>
