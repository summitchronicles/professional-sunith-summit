---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import ScrollReveal from '../../components/ui/ScrollReveal.astro';
import { getCollection } from 'astro:content';

const allWork = (await getCollection('work'))
  .filter((entry) => !entry.data.draft)
  .sort((a, b) => a.data.sortOrder - b.data.sortOrder);
---

<BaseLayout
  title="Work"
  description="What I've built when it mattered. Case studies in technology leadership, program delivery, and systems thinking."
>
  <section class="page-header">
    <div class="page-header-inner">
      <h1 class="reveal">What I've built<br />when it mattered</h1>
    </div>
  </section>

  <section class="work-list">
    <div class="work-list-inner">
      {allWork.map((entry) => (
        <a href={`/work/${entry.id.replace(/\.(mdx?|md)$/, '')}/`} class="work-card reveal">
          <span class="mono">{entry.data.year}</span>
          <h2>{entry.data.title}</h2>
        </a>
      ))}
    </div>
  </section>

  <ScrollReveal />
</BaseLayout>

<style>
  .page-header {
    padding: var(--space-3xl) var(--content-padding) var(--space-xl);
  }

  .page-header-inner {
    max-width: var(--content-width);
    margin: 0 auto;
  }

  .work-list {
    padding: 0 var(--content-padding) var(--space-3xl);
  }

  .work-list-inner {
    max-width: var(--content-width);
    margin: 0 auto;
  }

  .work-card {
    display: block;
    padding: var(--space-xl) 0;
    border-bottom: 1px solid var(--color-border);
    transition: opacity var(--transition-slow);
  }

  .work-card:first-child {
    border-top: 1px solid var(--color-border);
  }

  .work-card:hover {
    opacity: 0.7;
    color: var(--color-text-primary);
  }

  .work-card .mono {
    display: block;
    margin-bottom: var(--space-xs);
  }
</style>
