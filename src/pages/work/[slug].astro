---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('work', ({ data }) => !data.draft);
  return entries.map((entry) => ({
    params: { slug: entry.id.replace(/\.(mdx?|md)$/, '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title} description={entry.data.summary}>
  <article class="work-story">
    <header class="work-header">
      <a href="/#work" class="back-link mono">&larr; Selected work</a>
      <p class="mono work-meta">{entry.data.period} / {entry.data.role}</p>
      <h1>{entry.data.title}</h1>
      <p class="work-intro">{entry.data.summary}</p>
    </header>
    <div class="work-body prose">
      <Content />
    </div>
    <a class="work-contact" href="mailto:sunith07@gmail.com?subject=Let's%20talk%20about%20your%20work">
      Discuss a project <span aria-hidden="true">↗</span>
    </a>
  </article>
</BaseLayout>

<style>
  .work-story {
    max-width: var(--measure);
    margin: 0 auto;
    padding: 0 var(--content-padding) var(--space-2xl);
  }

  .work-header {
    padding: var(--space-3xl) 0 var(--space-xl);
    border-bottom: 1px solid var(--color-border);
  }

  .back-link {
    display: inline-block;
    margin-bottom: var(--space-xl);
  }

  .work-meta {
    margin-bottom: var(--space-md);
  }

  .work-header h1 {
    font-size: clamp(3rem, 7vw, 5.5rem);
  }

  .work-intro {
    max-width: 38ch;
    margin-top: var(--space-lg);
    color: var(--color-text-secondary);
    font-size: clamp(1.15rem, 2vw, 1.4rem);
  }

  .work-body {
    padding-top: var(--space-xl);
  }

  .work-body :global(h2) {
    margin: var(--space-xl) 0 var(--space-md);
  }

  .work-body :global(p),
  .work-body :global(li) {
    margin-bottom: var(--space-md);
    color: var(--color-text-secondary);
  }

  .work-body :global(ul) {
    padding-left: 1.5rem;
    list-style: disc;
  }

  .work-body :global(a),
  .work-contact {
    color: var(--color-text-primary);
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-underline-offset: 0.3em;
  }

  .work-contact {
    display: inline-flex;
    gap: 0.5rem;
    margin-top: var(--space-xl);
  }
</style>
