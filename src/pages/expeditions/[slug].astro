---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import ProtectedImage from '../../components/ui/ProtectedImage.astro';
import ScrollReveal from '../../components/ui/ScrollReveal.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('expeditions');
  return entries.map((entry) => ({
    params: { slug: entry.id.replace(/\.(mdx?|md)$/, '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { mountain, elevation, region, country, date, duration, heroImage } = entry.data;
---

<BaseLayout title={`${mountain} — Expeditions`} description={entry.data.summary}>
  <article class="expedition">
    <header class="expedition-header">
      <a href="/#expeditions" class="back-link mono reveal">&larr; Expeditions</a>
      <div class="expedition-meta reveal">
        <span class="mono">{elevation}</span>
        <span class="mono">{region}, {country}</span>
        <span class="mono">{duration}</span>
      </div>
      <h1 class="reveal">{mountain}</h1>
    </header>

    <div class="expedition-hero reveal">
      <ProtectedImage src={heroImage} alt={mountain} useCanvas={true} aspectRatio="21 / 9" />
    </div>

    <div class="expedition-body prose protected-content reveal">
      <Content />
    </div>
  </article>

  <ScrollReveal />
</BaseLayout>

<style>
  .expedition {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: 0 var(--content-padding);
  }

  .expedition-header {
    max-width: var(--measure);
    margin: 0 auto;
    padding: var(--space-3xl) 0 var(--space-xl);
  }

  .back-link {
    display: inline-block;
    margin-bottom: var(--space-xl);
    color: var(--color-text-muted);
    transition: color var(--transition-slow);
  }

  .back-link:hover {
    color: var(--color-text-primary);
  }

  .expedition-meta {
    display: flex;
    gap: var(--space-lg);
    margin-bottom: var(--space-md);
  }

  .expedition-hero {
    margin-bottom: var(--space-2xl);
  }

  .expedition-body {
    max-width: var(--measure);
    margin: 0 auto;
  }

  .expedition-body :global(h2) {
    margin-top: var(--space-2xl);
    margin-bottom: var(--space-md);
    font-size: 1.25rem;
    color: var(--color-text-primary);
  }

  .expedition-body :global(p) {
    margin-bottom: var(--space-md);
    color: var(--color-text-secondary);
    line-height: 1.8;
  }

  .expedition-body :global(p:last-child) {
    margin-bottom: 0;
  }
</style>
