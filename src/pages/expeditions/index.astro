---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import ScrollReveal from '../../components/ui/ScrollReveal.astro';
import { getCollection } from 'astro:content';

const allExpeditions = (await getCollection('expeditions'))
  .filter((entry) => !entry.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout
  title="Expeditions"
  description="Where theory meets consequence. Mountains are systems that reward judgment."
>
  <section class="page-header">
    <div class="page-header-inner">
      <h1 class="reveal">Where theory meets<br />consequence</h1>
    </div>
  </section>

  <section class="expedition-list">
    <div class="expedition-list-inner">
      {allExpeditions.map((entry) => (
        <a href={`/expeditions/${entry.id.replace(/\.(mdx?|md)$/, '')}/`} class="expedition-card reveal">
          <span class="mono">{entry.data.elevation}</span>
          <h2>{entry.data.mountain}</h2>
        </a>
      ))}
    </div>
  </section>

  <ScrollReveal />
</BaseLayout>

<style>
  .page-header {
    padding: var(--space-3xl) var(--content-padding) var(--space-xl);
  }

  .page-header-inner {
    max-width: var(--content-width);
    margin: 0 auto;
  }

  .expedition-list {
    padding: 0 var(--content-padding) var(--space-3xl);
  }

  .expedition-list-inner {
    max-width: var(--content-width);
    margin: 0 auto;
  }

  .expedition-card {
    display: block;
    padding: var(--space-xl) 0;
    border-bottom: 1px solid var(--color-border);
    transition: opacity var(--transition-slow);
  }

  .expedition-card:first-child {
    border-top: 1px solid var(--color-border);
  }

  .expedition-card:hover {
    opacity: 0.7;
    color: var(--color-text-primary);
  }

  .expedition-card .mono {
    display: block;
    margin-bottom: var(--space-xs);
  }
</style>
